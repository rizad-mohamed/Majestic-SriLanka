---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
const bodyFont = '/fonts/dm-sans-400.woff2';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import italicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/shapes.css';
import '../styles/refinements.css';
import '../styles/rendering.css';
import '../styles/mobile.css';
import '../styles/editorial.css';
import '../styles/responsive.css';
import '../styles/header.css';
import Header from '../components/Header.astro';
import CookiePreferences from '../components/CookiePreferences.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { pageSeo, siteTitle } from '../data/seo';
import { getSiteConfig, serializeJsonLd } from '../lib/site-config.mjs';
import { pageSchema, socialImage } from '../lib/schema';
interface Props { title?: string; description?: string; image?: string; bodyClass?: string }
const config = getSiteConfig(import.meta.env);
const page = pageSeo[Astro.url.pathname];
const title = siteTitle(page?.title || Astro.props.title || 'Page Not Found');
const description = page?.description || Astro.props.description;
const image = socialImage(page?.image || Astro.props.image || 'hero-sigiriya', config.siteUrl);
const canonical = new URL(Astro.url.pathname, config.siteUrl);
const indexable = config.indexable && !!page;
const schema = page ? pageSchema(Astro.url.pathname, page, config.siteUrl, title) : undefined;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />{Astro.url.pathname === "/" && <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin="anonymous" />}<meta name="theme-color" content="#073e33" /><title>{title}</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />{page && <link rel="canonical" href={canonical} />}<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" /><link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" /><link rel="manifest" href="/site.webmanifest" /><meta property="og:type" content="website" /><meta property="og:site_name" content="Majestic Sri Lanka" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={image.url} /><meta property="og:image:width" content={String(image.width)} /><meta property="og:image:height" content={String(image.height)} /><meta property="og:image:alt" content={page?.imageAlt || "Sri Lankan landscape"} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image.url} /><meta name="twitter:image:alt" content={page?.imageAlt || "Sri Lankan landscape"} />{schema && <script type="application/ld+json" set:html={serializeJsonLd(schema)} />}</head><body class={Astro.props.bodyClass}><svg width="0" height="0" class="shape-definitions" aria-hidden="true"><defs><clipPath id="experience-shape" clipPathUnits="objectBoundingBox"><path d="M0,.02 C.15,-.01 .26,.03 .42,.02 S.8,.05 1,.025 L1,.92 C.88,.91 .8,1 .66,.98 S.47,.86 .33,.88 S.12,.95 0,.98 Z" /></clipPath><clipPath id="tea-picker-shape" clipPathUnits="objectBoundingBox"><path d="M.02,.41 C.03,.2 .27,-.02 .53,.01 C.79,-.01 .91,.18 .98,.43 C1,.67 .94,.82 .76,.94 C.58,1.07 .27,.99 .12,.8 C.06,.68 .02,.53 .02,.41Z" /></clipPath></defs></svg><Header /><main id="main" tabindex="-1"><slot /></main><Footer /><CookiePreferences /><WhatsAppFloat /><Dialogs /><script>import '../scripts/site';</script></body></html>
