---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
const bodyFont = '/fonts/dm-sans-400.woff2';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import italicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/shapes.css';
import '../styles/refinements.css';
import '../styles/rendering.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
interface Props { title: string; description: string; image?: string }
const { title, description, image = 'hero-sigiriya' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`/assets/majestic-sri-lanka/photography/${image}-1600.webp`, Astro.site);
const indexable = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical.href, inLanguage: 'en', isPartOf: { '@type': 'WebSite', name: 'Majestic Sri Lanka', url: Astro.site?.href } };
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />{Astro.url.pathname === "/" && <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin="anonymous" />}<meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#073e33" /><title>{title} | Majestic Sri Lanka</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} /><link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><meta property="og:type" content="website" /><meta property="og:site_name" content="Majestic Sri Lanka" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={imageUrl} /><meta name="twitter:card" content="summary_large_image" /><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} /></head><body><svg width="0" height="0" class="shape-definitions" aria-hidden="true"><defs><clipPath id="experience-shape" clipPathUnits="objectBoundingBox"><path d="M0,.02 C.15,-.01 .26,.03 .42,.02 S.8,.05 1,.025 L1,.92 C.88,.91 .8,1 .66,.98 S.47,.86 .33,.88 S.12,.95 0,.98 Z" /></clipPath><clipPath id="tea-picker-shape" clipPathUnits="objectBoundingBox"><path d="M.02,.41 C.03,.2 .27,-.02 .53,.01 C.79,-.01 .91,.18 .98,.43 C1,.67 .94,.82 .76,.94 C.58,1.07 .27,.99 .12,.8 C.06,.68 .02,.53 .02,.41Z" /></clipPath></defs></svg><Header /><main id="main" tabindex="-1"><slot /></main><Footer /><Dialogs /><script>import '../scripts/site';</script></body></html>
