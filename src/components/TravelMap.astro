---
import { islandPath, mapPlaces } from '../data/travel-map';
interface Props { id: string }
const { id } = Astro.props;
---
<figure class="travel-map" aria-labelledby={`${id}-caption`}>
  <div class="map-canvas">
    <svg viewBox="0 0 400 430" aria-hidden="true" class="map-art">
      <ellipse class="map-water" cx="192" cy="222" rx="184" ry="200" />
      <path class="map-coast" d={islandPath} />
      <path class="map-island" d={islandPath} />
      {mapPlaces.map(place => <path class="map-route" data-map-route={place.id} d={place.route} />)}
      <text class="map-ocean-label" x="24" y="278" transform="rotate(-90 24 278)">INDIAN OCEAN</text>
      <path class="map-compass" d="M336 56V24M330 32L336 24L342 32" />
      <text class="map-north" x="331" y="16">N</text>
    </svg>
    {mapPlaces.map((place, index) => <details class="map-place" name={`${id}-places`} data-place={place.id} open={index === 0}>
      <summary class:list={['map-marker', `map-marker--${place.side}`]} style={`--pin-x:${place.x / 4}%;--pin-y:${place.y / 4.3}%`}><span class="map-pin" aria-hidden="true"></span><span class="map-marker-label">{place.name}</span></summary>
      <div class="map-place-panel"><h3>{place.title}</h3><p>{place.description}</p><a class="text-link" href={`/experiences/#${place.interest}`}>Explore this experience <span aria-hidden="true">→</span></a></div>
    </details>)}
  </div>
  <figcaption id={`${id}-caption`}>Select a place to explore.<span>Illustrative connections. Your route is tailored to you.</span></figcaption>
</figure>
