---
import manifest from '../../public/assets/majestic-sri-lanka/manifest.json';
import homepage from '../../public/assets/majestic-sri-lanka/homepage/manifest.json';
interface Props { name: string; alt: string; class?: string; eager?: boolean; sizes?: string; width?: number; height?: number; collection?: 'original' }
const { name, alt, class: className, eager = false, sizes = '(max-width: 700px) 100vw, 50vw', width, height, collection } = Astro.props;
const useHomepage = Astro.url.pathname === '/' && collection !== 'original';
const homeAsset = useHomepage ? homepage.assets.find(asset => asset.name === name) : undefined;
if (useHomepage && !homeAsset) throw new Error(`Missing licensed homepage photograph: ${name}`);
const base = `/assets/majestic-sri-lanka/photography/${name}`;
const asset = manifest.assets.find(asset => asset.name === name && 'variants' in asset);
const variants = homeAsset?.variants || (asset && 'variants' in asset ? asset.variants : []);
const uniqueWidths = new Map(variants?.map(variant => [variant.width, variant]));
const intrinsic = uniqueWidths.get(720) || [...uniqueWidths.values()].at(-1);
const srcset = [...uniqueWidths.values()].map(variant => `/assets/majestic-sri-lanka/${variant.file} ${variant.width}w`).join(', ');
---
<img src={homeAsset ? `/assets/majestic-sri-lanka/${intrinsic!.file}` : `${base}-720.webp`} srcset={srcset} sizes={sizes} alt={alt && homeAsset ? homeAsset.alt : alt} width={width || intrinsic?.width} height={height || intrinsic?.height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" class={className} data-photo={name} data-photo-collection={homeAsset ? 'homepage' : undefined} />
