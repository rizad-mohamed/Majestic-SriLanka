---
import { guestPhotos as photos, guestPhotoVersion } from "../data/guest-photos";

---
<section class="guest-gallery" aria-labelledby="guest-gallery-title" data-guest-gallery>
  <div class="container guest-gallery-heading">
    <div>
      <p class="eyebrow">MOMENTS ALONG THE WAY</p>
      <h2 id="guest-gallery-title">Their journeys. Real memories.</h2>
      <p>A glimpse of Sri Lanka through the moments our guests have shared.</p>
    </div>
    <div class="gallery-actions"><a class="text-link" href="/gallery/">View Gallery <span aria-hidden="true">→</span></a><button class="gallery-pause" type="button" aria-pressed="false" hidden>Pause gallery</button></div>
  </div>
  <div class="guest-gallery-window" tabindex="0" role="region" aria-label="Guest photo gallery. Scroll to browse photos.">
    <div class="guest-gallery-track">
      <div class="guest-gallery-group">
        {photos.map(([id, alt]) => <figure class="guest-gallery-photo"><img src={`/assets/majestic-sri-lanka/guests/cards/img_${id}.webp?v=${guestPhotoVersion}`} alt={alt} width="620" height="820" loading="lazy" decoding="async" /></figure>)}
      </div>
    </div>
  </div>
</section>

<style>
  .guest-gallery { padding: 30px 0 100px; }
  .guest-gallery-heading { display:flex; justify-content:space-between; align-items:end; gap:24px; margin-bottom:36px; }
  .guest-gallery-heading h2 { margin-bottom:16px; }
  .guest-gallery-heading p:last-child { color:var(--muted); margin-bottom:0; }
  .gallery-actions { display:flex; align-items:center; gap:24px; flex-shrink:0; }
  .gallery-pause { flex-shrink:0; border:0; border-radius:999px; padding:12px 22px; background:var(--green); color:var(--white); font:inherit; cursor:pointer; }
  .gallery-pause:hover { background:var(--green-hover); }
  .guest-gallery-window {
    --gallery-edge-fade: clamp(36px, 7vw, 120px);
    overflow-x:auto;
    scrollbar-width:none;
    overscroll-behavior-x:contain;
    -webkit-mask-image:linear-gradient(to right, transparent, black var(--gallery-edge-fade), black calc(100% - var(--gallery-edge-fade)), transparent);
    mask-image:linear-gradient(to right, transparent, black var(--gallery-edge-fade), black calc(100% - var(--gallery-edge-fade)), transparent);
  }
  .guest-gallery-window:focus-visible { -webkit-mask-image:none; mask-image:none; }
  .guest-gallery-window::-webkit-scrollbar { display:none; }
  .guest-gallery-track, .guest-gallery-group { display:flex; gap:20px; width:max-content; }
  .guest-gallery-group { padding-left:20px; }
  .guest-gallery-track { gap:0; }
  .guest-gallery-photo { margin:0; width:310px; height:410px; flex-shrink:0; border-radius:24px; overflow:hidden; background:var(--ivory); }
  .guest-gallery-photo img { width:100%; height:100%; object-fit:cover; object-position:right top; }
  @media(max-width:1000px) { .guest-gallery-heading { flex-wrap:wrap; } }
  @media(max-width:700px) {
    .guest-gallery { padding:16px 0 64px; }
    .guest-gallery-heading { align-items:start; flex-direction:column; margin-bottom:24px; }
    .guest-gallery-photo { width:250px; height:auto; aspect-ratio:31 / 41; border-radius:20px; }
    .guest-gallery-group { gap:14px; padding-left:14px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-guest-gallery]').forEach(gallery => {
    const viewport = gallery.querySelector<HTMLElement>('.guest-gallery-window')!;
    const track = gallery.querySelector<HTMLElement>('.guest-gallery-track')!;
    const group = gallery.querySelector<HTMLElement>('.guest-gallery-group')!;
    const button = gallery.querySelector<HTMLButtonElement>('.gallery-pause')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const copy = group.cloneNode(true) as HTMLElement;
    copy.setAttribute('aria-hidden', 'true');
    copy.querySelectorAll('img').forEach(img => img.alt = '');
    track.append(copy);
    button.hidden = false;
    let paused = false, hovered = false, focused = false, touching = false, visible = false;
    let previous = 0, position = viewport.scrollLeft, animation = 0;
    let distance = group.offsetWidth;
    const canPlay = () => visible && !document.hidden && !reduced.matches && !paused && !hovered && !focused && !touching;
    function synchronize() {
      cancelAnimationFrame(animation);
      animation = 0;
      previous = 0;
      position = viewport.scrollLeft;
      if (canPlay()) animation = requestAnimationFrame(frame);
    }
    // Cache geometry on resize instead of reading layout in every animation frame.
    new ResizeObserver(() => { distance = group.offsetWidth; }).observe(group);
    button.addEventListener('click', () => {
      paused = !paused;
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? 'Play gallery' : 'Pause gallery';
      synchronize();
    });
    viewport.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovered = true; synchronize(); } });
    viewport.addEventListener('pointerleave', () => { hovered = false; synchronize(); });
    viewport.addEventListener('focusin', () => { focused = true; synchronize(); });
    viewport.addEventListener('focusout', () => { focused = false; synchronize(); });
    viewport.addEventListener('touchstart', () => { touching = true; synchronize(); }, { passive:true });
    // Keep momentum scrolling under the visitor's control until another Play action.
    viewport.addEventListener('touchend', () => { touching = false; paused = true; button.setAttribute('aria-pressed', 'true'); button.textContent = 'Play gallery'; synchronize(); }, { passive:true });
    viewport.addEventListener('touchcancel', () => { touching = false; synchronize(); }, { passive:true });
    viewport.addEventListener('scroll', () => { if (hovered || focused || touching || paused || reduced.matches) position = viewport.scrollLeft; }, { passive:true });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; synchronize(); }).observe(viewport);
    document.addEventListener('visibilitychange', synchronize);
    reduced.addEventListener('change', synchronize);
    function frame(now: number) {
      animation = 0;
      if (!canPlay() || !distance) return;
      const elapsed = previous ? Math.min(now - previous, 50) : 0;
      previous = now;
      position = (position + elapsed * 0.035) % distance;
      viewport.scrollLeft = position;
      animation = requestAnimationFrame(frame);
    }
  });
</script>
