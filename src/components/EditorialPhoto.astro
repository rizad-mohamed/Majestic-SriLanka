---
import Photo from './Photo.astro';
interface Props {
  name: string;
  alt: string;
  inset?: string;
  insetAlt?: string;
  note?: string;
  class?: string;
}
const { name, alt, inset, insetAlt = '', note, class: className } = Astro.props;
---
<div class:list={['editorial-photo', className, { 'editorial-photo--layered': inset || note }]}>
  <img class="editorial-photo-leaves" src="/assets/majestic-sri-lanka/decorative/botanical-leaves.svg" width="190" height="330" alt="" aria-hidden="true" loading="lazy" />
  <Photo class="editorial-photo-main" name={name} alt={alt} sizes="(max-width: 1000px) 90vw, 44vw" />
  {inset && <Photo class="editorial-photo-inset" name={inset} alt={insetAlt} sizes="(max-width: 700px) 36vw, 20vw" />}
  {note && <span class="editorial-photo-note script" aria-hidden="true">{note}</span>}
</div>
