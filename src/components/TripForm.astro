---
import Icon from './Icon.astro';
import { tours, experiences, brand } from '../data/content';
---
<form id="trip-form" class="trip-form" data-email={brand.email} data-whatsapp={brand.whatsapp}>
  <div class="field-group">
    <div class="field"><label for="name">Your name <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required maxlength="100" aria-describedby="name-error" /><p class="field-error" id="name-error"></p></div>
    <div class="field"><label for="email">Email address <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-error" /><p class="field-error" id="email-error"></p></div>
    <div class="field"><label for="date">Approximate arrival <span aria-hidden="true">*</span></label><input id="date" name="date" type="date" required aria-describedby="date-error" /><p class="field-error" id="date-error"></p></div>
    <div class="field"><label for="travellers">Number of travellers <span aria-hidden="true">*</span></label><input id="travellers" name="travellers" type="number" min="1" max="30" step="1" value="2" required aria-describedby="travellers-error" /><p class="field-error" id="travellers-error"></p></div>
    <div class="field"><label for="duration">How long would you like to stay?</label><select id="duration" name="duration"><option>Flexible</option><option>Under a week</option><option>7–10 days</option><option>11–14 days</option><option>Two weeks or more</option></select></div>
    <div class="field"><label for="journey">A journey that caught your eye</label><select id="journey" name="journey"><option value="">A tailor-made journey</option>{tours.map(t => <option value={t.id}>{t.title}</option>)}</select></div>
    <div class="field full"><label for="notes">Tell us what a perfect trip looks like</label><textarea id="notes" name="notes" rows="4" maxlength="2000" placeholder="Your interests, travel pace, dietary or accessibility needs, and anything you’d love to experience…" aria-describedby="notes-error"></textarea><p class="field-error" id="notes-error"></p></div>
  </div>
  <fieldset><legend>What would you love to discover?</legend><div class="interest-options">{experiences.map(e => <label class="interest-option"><input type="checkbox" name="interests" value={e.title} data-interest={e.id} /><span>{e.title}</span></label>)}</div></fieldset>
  <div class="field"><label class="consent-field"><input type="checkbox" name="consent" id="consent" required aria-describedby="consent-error" /><span>I understand this creates a travel brief on my device. It is not a booking and is only shared if I choose an available email or WhatsApp handoff.</span></label><p class="field-error" id="consent-error"></p></div>
  <button type="submit" class="button button--primary" data-brief-submit disabled>Create My Travel Brief <Icon name="arrow" size={18} /></button>
  <p class="form-notice">Required fields are marked *. {brand.email || brand.whatsapp ? 'Review your brief before choosing how to share it.' : 'Online enquiry delivery is awaiting confirmed business contact details. You can download your brief now.'}</p>
  <p id="form-status" class="form-notice" aria-live="polite"></p>
  <section id="brief-summary" class="form-summary" aria-labelledby="brief-title" tabindex="-1" hidden><h3 id="brief-title">Your journey begins with an idea.</h3><p id="brief-text"></p><div class="button-row"><button id="download-brief" class="button button--primary" type="button"><Icon name="download" size={18} /> Download My Brief</button><a id="email-brief" class="button button--outline" hidden>Open Email <Icon name="mail" size={18} /></a><a id="whatsapp-brief" class="button button--outline" hidden>Open WhatsApp <Icon name="whatsapp" size={18} /></a></div><p class="form-notice">Downloading does not send an enquiry. Opening email or WhatsApp lets you review and send it in that service.</p></section>
  <noscript><p class="form-notice">The interactive brief builder needs JavaScript. No information is sent by this form. Please use the contact information on the Contact page when available.</p></noscript>
</form>
