---
import HeroStill from './HeroStill.astro';
import { heroSlides } from '../data/hero-slides';
---
<div class="hero-photograph" data-hero-image aria-live="off"><HeroStill name={heroSlides[0].id} active eager /><video data-hero-video data-src="/assets/majestic-sri-lanka/video/island-film.mp4" poster="/assets/majestic-sri-lanka/video/island-film-poster.webp" muted playsinline preload="none" width="960" height="540" aria-hidden="true"></video></div>
{heroSlides.map(slide => <template data-hero-template={slide.id}><HeroStill name={slide.id} /></template>)}
<script>import '../scripts/hero-slideshow';</script>
<style>
  .hero-photograph :global(img), .hero-photograph video { position: absolute; inset: 0; opacity: 1; }
  .hero-photograph video { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: opacity 650ms ease; }
  .hero-photograph video { opacity: 0; }
  .hero-photograph video.is-visible { opacity: 1; }
  .hero-photograph :global(.hero-frame) { opacity: 0; transition: opacity 650ms ease; }
  .hero-photograph :global(.hero-frame.is-visible) { opacity: 1; }
  @media (max-width: 1100px) { .hero-photograph :global([data-photo="hero-sigiriya"]) { object-position: 80% center; } }
  @media (max-width: 700px) { .hero-photograph :global([data-photo="hero-sigiriya"]) { object-position: 84% center; } }
  @media (prefers-reduced-motion: reduce) { .hero-photograph :global(.hero-frame), .hero-photograph video { transition: none; } }
</style>
