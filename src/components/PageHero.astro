---
import Photo from './Photo.astro';
interface Props { title: string; eyebrow: string; description: string; image: string; label: string }
const { title, eyebrow, description, image, label } = Astro.props;
---
<section class="page-hero" aria-labelledby="page-title"><Photo name={image} alt="" eager sizes="100vw" /><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{label}</span></nav><p class="eyebrow">{eyebrow}</p><h1 id="page-title" set:html={title} /><p>{description}</p></div></section>
