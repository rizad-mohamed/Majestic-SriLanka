---
import { brand } from '../data/content';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand"><a href="/" aria-label="Majestic Sri Lanka home"><img src="/assets/majestic-sri-lanka/branding/logo.svg" alt="Majestic Sri Lanka" width="218" height="62" loading="lazy" /></a><p>{brand.tagline}</p></div>
    <nav aria-label="Explore"><h2>Explore</h2><a href="/tours/">Tours</a><a href="/tailor-made/">Tailor-Made</a><a href="/experiences/">Experiences</a><a href="/about-us/">About Us</a></nav>
    <nav aria-label="Support"><h2>Support</h2><a href="/contact-us/">Contact Us</a><a href="/contact-us/#travel-faq">Travel FAQ</a><a href="/plan-your-trip/">Plan Your Trip</a><a href="/about-us/#responsible-travel">Responsible Travel</a></nav>
    <div class="footer-connect"><h2>Connect With Us</h2><a href="/contact-us/" class="footer-contact"><Icon name="mail" size={20} /> Let’s talk travel</a><p class="small">Social links · placeholders<br />to be confirmed.</p></div>
  </div>
  <div class="footer-bottom"><div class="container"><p>© {new Date().getFullYear()} Majestic Sri Lanka. All rights reserved.</p><div><button class="text-button" data-dialog="privacy-dialog">Privacy Policy</button><span aria-hidden="true">|</span><button class="text-button" data-dialog="terms-dialog">Terms of Service</button></div></div></div>
</footer>
