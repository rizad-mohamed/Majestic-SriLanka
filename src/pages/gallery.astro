---
import Layout from '../layouts/Layout.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Icon from '../components/Icon.astro';
import { guestPhotos, guestPhotoVersion } from '../data/guest-photos';
import sharp from 'sharp';
import { readFile } from 'node:fs/promises';
// Do not retain open photo file handles while the asset pipeline replaces them.
sharp.cache({ files: 0 });
const photos = await Promise.all(guestPhotos.map(async ([id, alt]) => {
  const file = `/assets/majestic-sri-lanka/guests/img_${id}.webp`;
  const src = `${file}?v=${guestPhotoVersion}`;
  const { width, height } = await sharp(await readFile(`public${file}`)).metadata();
  return { src, alt, width, height };
}));
---
<Layout>
  <section class="container gallery-page" aria-labelledby="gallery-title">
    <nav class="gallery-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Gallery</span></nav>
    <div class="gallery-intro">
      <div><p class="eyebrow">MOMENTS ALONG THE WAY</p><h1 id="gallery-title">Their journeys.<br />Real memories.</h1></div>
      <div><p>Shared meals, hilltop views and little moments in between. Explore our guests’ journeys through Sri Lanka.</p><a class="text-link" href="/itineraries/">Explore Itineraries <Icon name="arrow" size={18} /></a></div>
    </div>
    <div class="photo-wall">
      {photos.map((photo, index) => <a class="gallery-image" href={photo.src} data-gallery-photo aria-label={`View photo: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" /></a>)}
    </div>
  </section>
  <dialog class="gallery-lightbox" aria-labelledby="gallery-photo-caption">
    <button class="lightbox-close" type="button" data-close aria-label="Close photo"><Icon name="close" /></button>
    <figure><img class="lightbox-image" src={photos[0].src} alt="" width={photos[0].width} height={photos[0].height} loading="lazy" /><figcaption id="gallery-photo-caption"></figcaption></figure>
    <div class="lightbox-controls"><button type="button" data-photo-prev aria-label="Previous photo"><Icon name="back" /></button><span data-photo-count aria-live="polite"></span><button type="button" data-photo-next aria-label="Next photo"><Icon name="arrow" /></button></div>
  </dialog>
  <ClosingCTA />
</Layout>

<style>
  .gallery-page { padding-top:48px; padding-bottom:100px; }
  .gallery-breadcrumb { display:flex; gap:16px; color:var(--muted); font-size:14px; margin-bottom:52px; }
  .gallery-intro { display:grid; grid-template-columns:1.1fr 1fr; align-items:center; gap:60px; margin-bottom:52px; }
  .gallery-intro h1 { font-size:clamp(48px,5.5vw,80px); line-height:1; margin:0; }
  .gallery-intro p:not(.eyebrow) { max-width:440px; color:var(--muted); margin-bottom:24px; }
  .photo-wall { columns:3; column-gap:22px; }
  .gallery-image { display:block; break-inside:avoid; margin-bottom:22px; border-radius:18px; overflow:hidden; background:var(--ivory); }
  .gallery-image img { width:100%; height:auto; display:block; transition:transform 250ms ease; }
  .gallery-image:hover img { transform:scale(1.025); }
  .gallery-lightbox { padding:56px 24px 20px; width:min(1100px,95vw); max-width:95vw; max-height:94dvh; border:0; border-radius:18px; background:var(--green); color:var(--white); }
  .gallery-lightbox figure { margin:0; text-align:center; }
  .lightbox-image { display:block; max-width:100%; width:auto; height:auto; max-height:65dvh; object-fit:contain; margin:auto; }
  .gallery-lightbox figcaption { margin:16px auto; font-size:15px; }
  .lightbox-close { position:absolute; top:10px; right:14px; }
  .gallery-lightbox button { display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; border:0; border-radius:50%; background:var(--white); color:var(--green); cursor:pointer; }
  .lightbox-controls { display:flex; align-items:center; justify-content:center; gap:24px; }
  @media(max-width:900px) { .photo-wall { columns:2; } .gallery-intro { gap:32px; } }
  @media(max-width:600px) { .gallery-page { padding-top:28px; padding-bottom:64px; } .gallery-breadcrumb { margin-bottom:32px; } .gallery-intro { grid-template-columns:1fr; gap:24px; margin-bottom:32px; } .photo-wall { column-gap:12px; } .gallery-image { margin-bottom:12px; border-radius:12px; } }
  @media(prefers-reduced-motion:reduce) { .gallery-image img { transition:none; } .gallery-image:hover img { transform:none; } }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-photo]')];
  const dialog = document.querySelector<HTMLDialogElement>('.gallery-lightbox')!;
  const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
  const caption = dialog.querySelector<HTMLElement>('figcaption')!;
  const count = dialog.querySelector<HTMLElement>('[data-photo-count]')!;
  let current = 0;
  let opener: HTMLAnchorElement | undefined;
  function show(index: number) {
    current = (index + links.length) % links.length;
    const source = links[current].querySelector('img')!;
    image.src = source.src;
    image.alt = source.alt;
    image.width = source.width;
    image.height = source.height;
    caption.textContent = source.alt;
    count.textContent = `${current + 1} / ${links.length}`;
  }
  links.forEach((link, index) => link.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    opener = link;
    show(index);
    dialog.showModal();
    document.body.classList.add('dialog-is-open');
  }));
  dialog.querySelector('[data-photo-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-photo-next]')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
  });
  dialog.addEventListener('close', () => opener?.focus());
</script>
