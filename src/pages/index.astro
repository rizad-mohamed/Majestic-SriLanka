---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import TourCard from '../components/TourCard.astro';
import BenefitList from '../components/BenefitList.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { tours, experiences } from '../data/content';
const categories = [{ icon: 'leaf', text: 'Breathtaking\nDestinations' }, { icon: 'sun', text: 'Rich Culture\n& Heritage' }, { icon: 'wildlife', text: 'Unique Wildlife\nEncounters' }, { icon: 'beach', text: 'Stunning Beaches\n& Coastlines' }, { icon: 'mountain', text: 'Scenic Hill Country\n& Tea Trails' }];
const sampleReviews = [
  { quote: 'An unforgettable experience. Everything was perfectly organised and the team was so friendly and helpful.', name: 'Sarah M.', country: 'United Kingdom', initials: 'SM' },
  { quote: 'The perfect mix of culture, nature and relaxation. We felt truly looked after.', name: 'Daniel K.', country: 'Germany', initials: 'DK' },
  { quote: 'Authentic, well-planned and incredibly memorable. We can’t wait to return.', name: 'Priya S.', country: 'Singapore', initials: 'PS' },
];
---
<Layout title="Extraordinary Journeys, Real Connections" description="Discover Sri Lanka through private tours and tailor-made experiences, thoughtfully planned by locals. Explore culture, wildlife, tea country and the coast.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-photograph" data-hero-image><Photo name="hero-sigiriya" alt="Sigiriya rising above misty Sri Lankan jungle at sunrise" eager sizes="100vw" width={1774} height={887} /></div><div class="hero-fade"></div>
    <div class="container hero-inner"><div class="hero-copy"><p class="eyebrow">AUTHENTIC SRI LANKAN JOURNEYS</p><h1 id="hero-title">Extraordinary<br />Journeys,<br /><em>Real Connections.</em></h1><p class="hero-description">Private tours and tailor-made experiences,<br class="desktop-break" /> thoughtfully planned by locals who call Sri Lanka home.</p><div class="button-row"><Button href="/plan-your-trip/">Plan My Trip</Button><Button href="/tours/" variant="outline" arrow={false}>Explore Tours</Button></div><div class="hero-trust"><div class="avatar-stack" aria-hidden="true"><span>SM</span><span>DK</span><span>PS</span><span>AL</span></div><p>Your journey, thoughtfully planned</p></div><div class="hero-slides" aria-label="Choose a landscape"><button aria-label="Show Sigiriya landscape" aria-pressed="true" data-slide="hero-sigiriya">01</button><span></span><button aria-label="Show hill country landscape" aria-pressed="false" data-slide="hill-country">02</button><i></i><button aria-label="Show southern coast landscape" aria-pressed="false" data-slide="southern-coast">03</button></div></div></div>
    <span class="hero-annotation script" aria-hidden="true">More<br />Than a Destination</span><button class="watch-story" data-dialog="story-dialog"><span class="play-circle"><Icon name="play" size={26} /></span><span>Watch<br />Our Story</span></button><a class="scroll-cue" href="#our-story">Scroll<Icon name="mouse" size={31} /><span>↓</span></a>
  </section>
  <div class="category-strip container" aria-label="Discover Sri Lanka">{categories.map((item, index) => <a href={`/experiences/#${experiences[index]?.id}`}><Icon name={item.icon} size={41} /><span>{item.text.split('\n').map(line => <span>{line}</span>)}</span></a>)}</div>
  <div class="deferred-section deferred-story"><section class="story-section container" id="our-story" aria-labelledby="story-heading">
    <div class="story-collage"><img class="story-leaves" src="/assets/majestic-sri-lanka/decorative/botanical-leaves.svg" alt="" width="190" height="330" loading="lazy" /><Photo class="story-landscape" name="hill-country" alt="Lush tea terraces and layered mountains in Sri Lanka’s hill country" sizes="25vw" /><Photo class="story-elephant" name="elephant" alt="An Asian elephant walking through leafy Sri Lankan forest" width={1122} height={1402} sizes="(max-width: 700px) 65vw, 28vw" /><img class="story-note" src="/assets/majestic-sri-lanka/decorative/sticky-note-local.svg" alt="Authentic Local Experiences" width="205" height="145" loading="lazy" /></div>
    <div class="story-copy"><p class="eyebrow">OUR STORY</p><h2 id="story-heading">Local People.<br />Meaningful Journeys.</h2><p>We are a Sri Lankan team passionate about sharing the real Sri Lanka – its places, people and stories. With genuine local knowledge and personalised service, we create journeys that go beyond the ordinary.</p><Button href="/about-us/">Our Story</Button><img class="story-stamp" src="/assets/majestic-sri-lanka/decorative/locally-curated-stamp.svg" alt="Locally curated, Sri Lanka" width="146" height="146" loading="lazy" /><img class="story-branch" src="/assets/majestic-sri-lanka/decorative/botanical-branch.svg" alt="" width="200" height="300" loading="lazy" /><div class="story-perks">{[{ icon: 'gem', title: 'Personalised\nItineraries' }, { icon: 'people', title: 'Local\nExpertise' }, { icon: 'heart', title: 'Responsible\nTravel' }, { icon: 'support', title: 'End-to-End\nSupport' }].map(item => <div><Icon name={item.icon} size={29} /><span>{item.title.split('\n').map(line => <span>{line}</span>)}</span></div>)}</div></div>
  </section></div>
  <div class="deferred-section deferred-featured"><section class="featured-section container" aria-labelledby="featured-title"><div class="section-header"><div><p class="eyebrow">FEATURED TOURS</p><h2 id="featured-title">Journeys to Remember</h2><p>Carefully crafted itineraries to experience the very best of Sri Lanka.</p></div><div class="section-actions"><a class="text-link" href="/tours/">View All Tours <Icon name="arrow" size={18} /></a><button class="circle-button" data-tour-direction="-1" aria-label="Previous featured tour"><Icon name="back" size={19} /></button><button class="circle-button" data-tour-direction="1" aria-label="Next featured tour"><Icon name="arrow" size={19} /></button></div></div><div class="tour-carousel"><button class="circle-button carousel-side previous" data-tour-direction="-1" aria-label="Previous tour"><Icon name="back" size={19} /></button><div class="tour-grid" data-tour-track>{tours.map(tour => <TourCard tour={tour} />)}</div><button class="circle-button carousel-side next" data-tour-direction="1" aria-label="Next tour"><Icon name="arrow" size={19} /></button></div><p class="sr-only" data-carousel-status aria-live="polite"></p></section></div>
  <div class="deferred-section deferred-experience"><section class="experience-section" aria-labelledby="experience-title"><div class="experience-picture"><Photo name="reservoir-travellers" alt="Two travellers sitting on a rocky viewpoint above a winding Sri Lankan reservoir" sizes="(max-width: 700px) 100vw, 50vw" /><span class="script" aria-hidden="true">Unforgettable<br />Moments</span></div><div class="experience-content"><p class="eyebrow">EXPLORE EXPERIENCES</p><h2 id="experience-title">Find Your Perfect<br />Sri Lankan Experience</h2><p>From wildlife and culture to beaches and food, discover experiences that make Sri Lanka truly special.</p><div class="experience-cards">{experiences.map(item => <a class="experience-card" href={`/experiences/#${item.id}`}><Photo name={item.image} alt="" sizes="(max-width: 700px) 35vw, 9vw" width={480} height={800} /><span class="experience-card-copy"><Icon name={item.icon} size={23} /><strong>{item.title}</strong><span class="tiny-arrow"><Icon name="arrow" size={13} /></span></span></a>)}</div><a class="text-link" href="/experiences/">View All Experiences <Icon name="arrow" size={18} /></a></div></section></div>
  <div class="deferred-section deferred-why"><section class="why-section container" aria-labelledby="why-title"><div class="why-top"><div class="why-copy"><p class="eyebrow">WHY TRAVEL WITH US</p><h2 id="why-title">A More Personal<br />Way to Explore</h2><p>With deep local knowledge and a passion for responsible travel, we create meaningful experiences that showcase the real Sri Lanka.</p></div><div class="why-picture"><Photo name="tea-pickers" alt="Two Sri Lankan women gathering fresh leaves among green tea bushes" sizes="(max-width: 700px) 100vw, 45vw" /><img src="/assets/majestic-sri-lanka/decorative/sticky-note-people.svg" alt="People Places Stories" width="160" height="180" loading="lazy" /></div></div><BenefitList /></section></div>
  <div class="deferred-section deferred-testimonials"><section class="testimonials-section container" id="guest-stories" aria-labelledby="testimonials-title"><div class="section-header"><div><p class="eyebrow">TRAVELLER STORIES</p><h2 id="testimonials-title">Kind Words from Our Guests</h2></div><a class="text-link" href="/about-us/#guest-stories">About These Stories <Icon name="arrow" size={18} /></a></div><div class="review-grid">{sampleReviews.map(item => <figure class="review-card"><blockquote><span class="quote-mark" aria-hidden="true">“</span>{item.quote}</blockquote><figcaption><span class="review-avatar" aria-hidden="true">{item.initials}</span><span><strong>{item.name}</strong><small>{item.country}</small></span><span class="stars" aria-label="Sample five-star rating">★★★★★</span></figcaption></figure>)}</div><p class="review-notice">Design preview: stories supplied in the reference, awaiting verification.</p></section></div>
  <div class="deferred-section deferred-cta"><ClosingCTA /></div>
</Layout>
