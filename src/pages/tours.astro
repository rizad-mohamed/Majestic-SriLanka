---
import Layout from '../layouts/Layout.astro';
import BotanicalAccent from '../components/BotanicalAccent.astro';
import PageHero from '../components/PageHero.astro';
import TourCard from '../components/TourCard.astro';
import GuestGallery from '../components/GuestGallery.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { tours } from '../data/content';
---
<Layout><PageHero title="Journeys to<br />Remember" eyebrow="OUR PRIVATE ITINERARIES" description="A few thoughtfully crafted starting points. A world of possibilities to make them yours." image="hero-sigiriya" label="Itineraries" /><section class="container page-section itinerary-list-section" aria-labelledby="tour-list-title"><div class="page-intro tour-intro botanical-heading"><BotanicalAccent /><p class="eyebrow">FIND YOUR JOURNEY</p><h2 id="tour-list-title">An island. Your way.</h2><p>Culture, nature or time by the sea — choose what calls to you. Every journey can be shaped around your interests and pace.</p></div><div class="filter-row" aria-label="Filter journeys">{['All', 'Culture', 'Nature', 'Coast'].map(filter => <button class="filter-button" data-filter={filter} aria-pressed={filter === 'All'}>{filter === 'All' ? 'All Journeys' : filter}</button>)}</div><div class="tour-grid listing">{tours.map(tour => <TourCard tour={tour} />)}</div><p class="filter-status" data-filter-status aria-live="polite">3 journeys to explore</p><p class="itinerary-context">These are suggested itineraries to inspire your planning. Your final route, inclusions, accommodation and pricing are confirmed in a personal proposal. No booking or payment is taken here.</p><p class="itinerary-context">Find <a class="text-link" href="/experiences/">experiences for your journey</a> or learn about <a class="text-link" href="/tailor-made/">personalising an itinerary</a>.</p></section><GuestGallery /><ClosingCTA /></Layout>

<style>
  .itinerary-list-section { padding-bottom:18px; }
  .itinerary-context { margin:12px 0 0; padding:0; max-width:960px; font-size:14px; line-height:1.6; color:var(--muted); }
  .itinerary-context + .itinerary-context { margin-top:8px; }
  .itinerary-list-section > :last-child { margin-bottom:0; }
  @media(max-width:700px) {
    .itinerary-list-section { padding-bottom:12px; }
  }
</style>
