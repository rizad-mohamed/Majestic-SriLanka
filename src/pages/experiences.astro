---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { experiences } from '../data/content';
---
<Layout><PageHero title="Moments That<br />Stay With You" eyebrow="EXPLORE EXPERIENCES" description="From a quiet wildlife encounter to the warmth of a shared meal. Discover the island through the things you love." image="hill-country" label="Experiences" /><div class="container page-section">{experiences.map(item => <section id={item.id} class="experience-detail" aria-labelledby={`${item.id}-title`}><Photo name={item.image} alt={item.alt} sizes="(max-width: 700px) calc(100vw - clamp(40px, 12.3vw, 48px)), (max-width: 1200px) calc(40vw - 40px), (max-width: 1400px) calc(40vw - 64px), 496px" /><div><p class="eyebrow"><Icon name={item.icon} size={29} /></p><h2 id={`${item.id}-title`}>{item.title}</h2><p>{item.description}</p><p class="detail-tip">{item.detail}</p><Button href={`/plan-your-trip/?interest=${item.id}#trip-form`}>Add to My Journey</Button></div></section>)}<p class="journey-note">Build these interests into <a class="text-link" href="/tours/">a suggested Sri Lanka itinerary</a>, or explore <a class="text-link" href="/tailor-made/">tailor-made planning</a>.</p></div><ClosingCTA /></Layout>
