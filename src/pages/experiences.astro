---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { experiences } from '../data/content';
---
<Layout title="Sri Lankan Experiences" description="Find your connection to Sri Lanka through wildlife, culture, beaches, tea country and food. Discover experiences to shape a personal journey." image="hill-country"><PageHero title="Moments That<br />Stay With You" eyebrow="EXPLORE EXPERIENCES" description="From a quiet wildlife encounter to the warmth of a shared meal. Discover the island through the things you love." image="hill-country" label="Experiences" /><div class="container page-section">{experiences.map(item => <section id={item.id} class="experience-detail" aria-labelledby={`${item.id}-title`}><Photo name={item.image} alt={item.title === 'Wildlife & Nature' ? 'An elephant in tropical forest' : item.title} sizes="(max-width: 700px) 100vw, 40vw" /><div><p class="eyebrow"><Icon name={item.icon} size={29} /></p><h2 id={`${item.id}-title`}>{item.title}</h2><p>{item.description}</p><p class="detail-tip">{item.detail}</p><Button href={`/plan-your-trip/?interest=${item.id}#trip-form`}>Add to My Journey</Button></div></section>)}</div><ClosingCTA /></Layout>
