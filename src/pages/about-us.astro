---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import BenefitList from '../components/BenefitList.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
---
<Layout title="Our Story — Local People, Meaningful Journeys" description="Meet the approach behind Majestic Sri Lanka: genuine local knowledge, personalised journeys and thoughtful connections to the island’s places, people and stories." image="tea-pickers"><PageHero title="Local People.<br />Meaningful Journeys." eyebrow="OUR STORY" description="We call Sri Lanka home. Sharing its places, people and stories is at the heart of every journey we create." image="tea-pickers" label="About" /><section class="container page-section editorial-split" aria-labelledby="about-title"><Photo name="reservoir-travellers" alt="Travellers looking over a Sri Lankan reservoir and green mountains" /><div class="editorial-copy"><p class="eyebrow">MORE THAN A DESTINATION</p><h2 id="about-title">An island we know.<br />A journey you’ll feel.</h2><p>We are a Sri Lankan team passionate about sharing the real Sri Lanka – its places, people and stories. With genuine local knowledge and personalised service, we create journeys that go beyond the ordinary.</p><p>That means making room for what matters to you. An unhurried morning. A conversation along the way. Time to follow your curiosity, rather than simply follow a checklist.</p><p class="script">People. Places. Stories.</p><Button href="/plan-your-trip/">Let’s Plan Your Journey</Button></div></section><section class="soft-section page-section" id="responsible-travel" aria-labelledby="responsible-title"><div class="container"><p class="eyebrow">TRAVEL WITH CARE</p><h2 id="responsible-title">Good journeys leave<br />thoughtful footprints.</h2><div class="values-grid"><div class="value-item"><Icon name="people" size={36} /><h3>People at the heart</h3><p>Choose local businesses, listen to the people who know a place and seek permission before taking photographs.</p></div><div class="value-item"><Icon name="wildlife" size={36} /><h3>Wildlife with respect</h3><p>Observe animals at a distance, avoid feeding or handling them and let their natural behaviour lead the encounter.</p></div><div class="value-item"><Icon name="leaf" size={36} /><h3>A lighter way to explore</h3><p>Take your time, reduce waste where possible and respect the landscapes and cultural places that make each journey special.</p></div></div></div></section><section class="container page-section" aria-label="Our approach"><BenefitList /></section><section class="container page-section" id="guest-stories" aria-labelledby="guest-story-title"><div class="page-intro"><p class="eyebrow">TRAVELLER STORIES</p><h2 id="guest-story-title">Stories deserve<br />to be authentic.</h2><p>The homepage currently shows illustrative quotations and names supplied in the approved design reference. They have not been verified as customer reviews. Verified testimonials and publication permission are required before public launch.</p></div><Button href="/contact-us/" variant="outline">Get in Touch</Button></section><ClosingCTA /></Layout>
