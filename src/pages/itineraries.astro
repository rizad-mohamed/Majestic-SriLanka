---
import Layout from '../layouts/Layout.astro';
import BotanicalAccent from '../components/BotanicalAccent.astro';
import PageHero from '../components/PageHero.astro';
import TourCard from '../components/TourCard.astro';
import GuestGallery from '../components/GuestGallery.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { tours } from '../data/content';
import Icon from '../components/Icon.astro';
const filters = ['All', 'Culture', 'Nature', 'Coast', 'Couples'];
---
<Layout><PageHero title="Journeys to<br />Remember" eyebrow="OUR PRIVATE ITINERARIES" description="A few thoughtfully crafted starting points. A world of possibilities to make them yours." image="hero-sigiriya" label="Itineraries" /><section class="container page-section itinerary-list-section" aria-labelledby="tour-list-title"><div class="page-intro tour-intro botanical-heading"><BotanicalAccent /><p class="eyebrow">FIND YOUR JOURNEY</p><h2 id="tour-list-title">An island. Your way.</h2><p>Culture, wildlife, time by the sea or a couples’ escape — choose what calls to you. Every journey can be shaped around your interests and pace.</p></div><div class="journey-controls"><div class="journey-filters" hidden>
      <div class="filter-row" role="group" aria-label="Journey type">
        {filters.map(filter => <button class="filter-button" type="button" value={filter} aria-controls="journey-slides" aria-pressed={filter === 'All'}>{filter === 'All' ? 'All Journeys' : filter}</button>)}
      </div>
      <div class="journey-filter"><label for="journey-category">Journey type</label><div class="journey-select"><select id="journey-category" aria-controls="journey-slides">{filters.map(filter => <option value={filter}>{filter === 'All' ? 'All journeys' : filter}</option>)}</select><Icon name="down" size={16} /></div></div></div><div class="journey-arrows" data-journey-arrows hidden><button class="circle-button" type="button" data-journey-step="-1" aria-label="Previous journey" aria-controls="journey-slides"><Icon name="back" size={19} /></button><button class="circle-button" type="button" data-journey-step="1" aria-label="Next journey" aria-controls="journey-slides"><Icon name="arrow" size={19} /></button></div></div><div class="journey-slides" id="journey-slides" tabindex="0" role="region" aria-label="Journeys">{tours.map(tour => <TourCard tour={tour} />)}</div><p class="filter-status" data-filter-status aria-live="polite">{tours.length} journeys to explore</p><p class="itinerary-context">These are suggested itineraries to inspire your planning. Your final route, inclusions, accommodation and pricing are confirmed in a personal proposal. No booking or payment is taken here.</p><p class="itinerary-context">Find <a class="text-link" href="/experiences/">experiences for your journey</a> or learn about <a class="text-link" href="/tailor-made/">personalising an itinerary</a>.</p></section><GuestGallery /><ClosingCTA /></Layout>

<script>
  const journeySlides = document.querySelector<HTMLElement>("#journey-slides")!;
  const journeyArrows = document.querySelector<HTMLElement>(
    "[data-journey-arrows]",
  )!;
  const journeySteps = journeyArrows.querySelectorAll<HTMLButtonElement>(
    "[data-journey-step]",
  );

  function updateJourneyArrows() {
    const end = journeySlides.scrollWidth - journeySlides.clientWidth;
    journeyArrows.hidden = end <= 1;
    journeySteps[0].setAttribute(
      "aria-disabled",
      String(journeySlides.scrollLeft <= 1),
    );
    journeySteps[1].setAttribute(
      "aria-disabled",
      String(journeySlides.scrollLeft >= end - 1),
    );
  }

  journeySlides.addEventListener("scroll", updateJourneyArrows, {
    passive: true,
  });
  new ResizeObserver(updateJourneyArrows).observe(journeySlides);
  journeySteps.forEach((button) => {
    button.addEventListener("click", () => {
      if (button.getAttribute("aria-disabled") === "true") return;
      const [first, second] = journeySlides.querySelectorAll<HTMLElement>(
        ".tour-card:not([hidden])",
      );
      if (!first || !second) return;
      const distance = second.offsetLeft - first.offsetLeft;
      journeySlides.scrollBy(distance * Number(button.dataset.journeyStep), 0);
    });
  });

  const filters = document.querySelector<HTMLElement>(".journey-filters")!;
  const category = document.querySelector<HTMLSelectElement>("#journey-category")!;
  const buttons = filters.querySelectorAll<HTMLButtonElement>(".filter-button");
  const status = document.querySelector("[data-filter-status]")!;
  const cards = journeySlides.querySelectorAll<HTMLElement>("[data-category]");

  const filterJourneys = (value: string) => {
    category.value = value;
    buttons.forEach(button => button.setAttribute("aria-pressed", String(button.value === value)));
    let count = 0;
    cards.forEach(card => {
      card.hidden = value !== "All" && card.dataset.category !== value;
      if (!card.hidden) count++;
    });
    journeySlides.scrollTo({ left: 0, behavior: "instant" });
    updateJourneyArrows();
    status.textContent = `${count} ${count === 1 ? "journey" : "journeys"} to explore`;
  };

  filters.hidden = false;
  filterJourneys(category.value);
  category.addEventListener("change", () => filterJourneys(category.value));
  buttons.forEach(button => button.addEventListener("click", () => filterJourneys(button.value)));
</script>

<style>
.journey-filters { flex: 1; min-width: 0; max-width: 700px; }
.filter-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}
.filter-button {
  border: 1px solid var(--line);
  border-radius: 100px;
  padding: 11px 8px;
  min-height: 44px;
  font-size: 13px;
}
.filter-button:hover { border-color: var(--green); }
.filter-button[aria-pressed="true"] {
  background: var(--green);
  color: white;
  border-color: var(--green);
}
.journey-filter { display: none; max-width: 230px; }
.journey-filter label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin: 0 0 5px 12px;
}
.journey-select { position: relative; }
.journey-select select {
  appearance: none;
  width: 100%;
  min-height: 46px;
  padding: 8px 38px 8px 16px;
  border: 1px solid var(--green);
  border-radius: 100px;
  background: var(--white);
  color: var(--green);
  font: inherit;
  font-size: 16px;
}
.journey-select :global(svg) {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--green);
  pointer-events: none;
}
.filter-status {
  margin-top: 25px;
  font-size: 13px;
}

  .journey-controls { display:flex; justify-content:space-between; align-items:center; gap:18px; margin-bottom:18px; }
  .journey-arrows:not([hidden]) { display:flex; gap:8px; }
  .journey-arrows button[aria-disabled="true"] { opacity:.45; cursor:default; }
  .journey-slides {
    --journey-gap:22px;
    --journey-width:calc((100% - 2 * var(--journey-gap)) / 3);
    display:grid;
    grid-auto-flow:column;
    grid-auto-columns:var(--journey-width);
    gap:var(--journey-gap);
    overflow-x:auto;
    overscroll-behavior-inline:contain;
    scroll-snap-type:x mandatory;
    scroll-padding-inline:6px;
    padding:4px 6px 22px;
    margin-inline:-6px;
    scrollbar-width:thin;
    scrollbar-color:#c2cfc4 transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .journey-slides { scroll-behavior:smooth; }
  }
  .journey-slides :global(.tour-card) { scroll-snap-align:start; }
  .journey-slides :global(.tour-card[hidden]) { display:none; }
  .journey-slides :global(.tour-content) { display:flex; flex-direction:column; align-items:flex-start; flex:1; }
  .journey-slides :global(.tour-card:not([hidden])) { display:flex; flex-direction:column; }
  .journey-slides :global(.tour-link) { margin-top:auto; }
  .journey-slides :global(.tour-content > p) { margin-bottom:14px; }
  @media(max-width:1000px) { .journey-slides { --journey-width:calc((100% - var(--journey-gap)) / 2); } }
  @media(max-width:700px) {
    .journey-controls { gap:12px; align-items:flex-end; }
    .filter-row { display:none; }
    .journey-filter { display:block; }
    .journey-slides { --journey-gap:14px; --journey-width:88%; }
    .journey-slides:has(.tour-card:not([hidden])):not(:has(.tour-card:not([hidden]) ~ .tour-card:not([hidden]))) { --journey-width:100%; }
  }
  .itinerary-list-section { padding-bottom:18px; }
  .itinerary-context { margin:12px 0 0; padding:0; max-width:960px; font-size:14px; line-height:1.6; color:var(--muted); }
  .itinerary-context .text-link { display:inline; }
  .itinerary-context + .itinerary-context { margin-top:8px; }
  .itinerary-list-section > :last-child { margin-bottom:0; }
  @media(max-width:700px) {
    .itinerary-list-section { padding-bottom:12px; }
  }
</style>
