---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import TripForm from '../components/TripForm.astro';
---
<Layout bodyClass="planner-page" title="Plan Your Sri Lanka Trip" description="Begin a Sri Lankan journey designed around your interests, pace and people. Create a personal travel brief with the Majestic Sri Lanka trip planner." image="reservoir-travellers"><PageHero title="Plan Your<br />Sri Lankan Journey." eyebrow="YOUR JOURNEY STARTS HERE" description="The places you dream of. The pace that feels right. A journey as individual as you are." image="reservoir-travellers" label="Plan Your Trip" /><section class="container page-section planner-layout" aria-labelledby="planner-title"><div class="planner-aside"><p class="eyebrow">LET’S BEGIN</p><h2 id="planner-title">A little about you.<br />Endless possibilities.</h2><p>Tell us what matters to you. This travel brief brings your ideas together, ready for a personal planning conversation.</p><details class="planner-process"><summary>How planning works</summary><ol class="planning-steps"><li><strong>Share your ideas</strong>Your dates, favourite experiences and the people coming along.</li><li><strong>Shape the journey</strong>A considered route, with space for the moments in between.</li><li><strong>Make it personal</strong>Refine the details together before confirming your plans.</li></ol></details></div><TripForm /></section></Layout>
