{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    ".agents",
    ".local",
    ".taste-skill",
    ".lighthouseci",
    "playwright-report",
    "test-results",
    "deliverables"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
