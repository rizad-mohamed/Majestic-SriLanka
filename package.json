{
  "name": "majestic-sri-lanka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/validate-build.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:logo": "node scripts/prepare-logo.mjs",
    "assets:archive": "node scripts/archive-assets.mjs",
    "format:check": "prettier --check astro.config.mjs tsconfig.json package.json playwright*.ts scripts/validate-build.mjs scripts/lighthouse.mjs scripts/test-production.mjs scripts/measure-build.mjs scripts/prepare-hero-avif.mjs scripts/prepare-experience-assets.mjs scripts/prepare-hero-video.mjs scripts/prepare-favicons.mjs scripts/prepare-mobile-hero.mjs src/data/seo.ts src/lib/schema.ts src/lib/site-config.mjs src/lib/site-config.d.mts \"src/scripts/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"docs/seo/*.md\" \".github/**/*.yml\"",
    "test:production": "node scripts/test-production.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "assets:hero": "node scripts/prepare-hero-avif.mjs",
    "assets:hero-mobile": "node scripts/prepare-mobile-hero.mjs",
    "assets:experiences": "node scripts/prepare-experience-assets.mjs",
    "assets:favicons": "node scripts/prepare-favicons.mjs",
    "assets:video": "node scripts/prepare-hero-video.mjs",
    "assets:guest-watermarks": "node scripts/prepare-guest-watermarks.mjs"
  },
  "dependencies": {
    "@lucide/astro": "^1.66.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/caveat": "^5.2.7",
    "@fontsource/cormorant-garamond": "^5.2.7",
    "@playwright/test": "^1.56.0",
    "archiver": "^8.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.2",
    "prettier": "3.9.10"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  }
}
